# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is in .gitignore.

# Required: Your GCP project ID (find it in GCP Console -> Project selector)
project_id = "your-gcp-project-id"

# GCP region for all resources. Pick one close to your users.
# Options: us-central1, us-east1, us-west1, europe-west1, asia-east1
region = "us-central1"

# Environment tag. Used in resource naming to allow multiple environments.
environment = "dev"

# Cloud SQL machine tier.
# Dev: "db-f1-micro" (~$7/month)
# Prod: "db-custom-2-7680" (2 vCPU, 7.5GB RAM)
db_tier = "db-f1-micro"

# Memorystore Redis memory in GB. Minimum is 1 (~$16/month).
redis_memory_size_gb = 1

# GCE machine type for the app server.
# e2-standard-2 (2 vCPU, 8GB RAM) handles ~12 concurrent bots.
# Scale to e2-standard-4 for 20 bots.
machine_type = "e2-standard-2"

# Restrict SSH access to your own IP for better security.
# Find your IP: curl ifconfig.me
ssh_source_ranges = ["0.0.0.0/0"]
